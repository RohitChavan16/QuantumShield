# App
APP_ENV=local
LOG_LEVEL=debug

# Backend server
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinelfuse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpass
POSTGRES_DSN=postgres://postgres:devpass@postgres:5432/sentinelfuse?sslmode=disable

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=change-me-in-real-env
JWT_EXPIRY_MINUTES=60

# AI
GEMINI_API_KEY=
